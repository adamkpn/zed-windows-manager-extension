# Zed Windows (Raycast/Tinycast extension) + the "Zed Open" droplet — single
# entrypoint for build, test, lint, security and install. Targets wrap the
# scripts in package.json; run `make` for the list.

.DEFAULT_GOAL := help
SHELL := /bin/sh

SEVERITY ?= HIGH,CRITICAL
DROPLET_NAME ?= Zed Open
DROPLET_DIR ?= $(HOME)/Applications
DROPLET_APP := $(DROPLET_DIR)/$(DROPLET_NAME).app

# Scanners run as throwaway containers — nothing to install locally.
# The named volume caches Trivy's ~250MB vulnerability DB between runs.
TRIVY := docker run --rm -v zed-windows-trivy-cache:/root/.cache/trivy
# gitleaks runs as root over a bind mount owned by another uid; without this
# git aborts with "detected dubious ownership in repository".
GITLEAKS_GIT := -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo

##@ 📖 Help

help: ## Show this help
	@awk 'BEGIN {FS = ":.*##"} \
		/^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5); next } \
		/^[a-zA-Z_0-9-]+:.*?##/ { printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2 }' \
		$(MAKEFILE_LIST)
	@printf "\n\033[2mVars: SEVERITY DROPLET_NAME DROPLET_DIR\033[0m\n\n"

##@ 📦 Setup

install: ## Install dependencies from the lockfile
	npm ci

##@ 🏗️ Build

build: ## Build the extension (ray build)
	npm run build

build-dist: ## Build into dist/ for Tinycast's "Add from folder"
	npm run build:dist

icon: ## Render assets/icon.png (512x512) from assets/icon.svg
	@command -v rsvg-convert >/dev/null || { echo "❌ Needs rsvg-convert: brew install librsvg"; exit 1; }
	rsvg-convert -w 512 -h 512 assets/icon.svg -o assets/icon.png
	@echo "wrote assets/icon.png"

droplet: ## Build "~/Applications/Zed Open.app" (open in Zed, reusing an open window)
	@[ "$$(uname)" = Darwin ] || { echo "❌ macOS only"; exit 1; }
	@tmp=$$(mktemp -d) && trap 'rm -rf "$$tmp"' EXIT && \
	osacompile -o "$$tmp/$(DROPLET_NAME).app" droplet/main.applescript && \
	install -m 0755 droplet/zed-open.sh "$$tmp/$(DROPLET_NAME).app/Contents/Resources/zed-open.sh" && \
	codesign --force --deep --sign - "$$tmp/$(DROPLET_NAME).app" && \
	mkdir -p "$(DROPLET_DIR)" && \
	if [ -e "$(DROPLET_APP)" ]; then \
		[ -f "$(DROPLET_APP)/Contents/Resources/zed-open.sh" ] || { \
			echo "❌ $(DROPLET_APP) exists and wasn't built here; not replacing it"; exit 1; }; \
		rm -rf "$(DROPLET_APP)"; \
	fi && \
	mv "$$tmp/$(DROPLET_NAME).app" "$(DROPLET_APP)"
	@echo "✅ built $(DROPLET_APP)"
	@echo "   Tinycast → Git Repos → preferences → \"Open with\" (↵): pick $(DROPLET_NAME).app"

##@ 🧪 Test

test: ## Unit tests for src/lib and droplet/zed-open.sh (node:test via tsx)
	npm test

typecheck: raycast-env.d.ts ## Type-check without emitting
	npm run typecheck

# Generated by `ray build`; typecheck needs its Preferences types.
raycast-env.d.ts: package.json
	npm run build

shellcheck: require-docker ## Lint droplet/zed-open.sh with ShellCheck
	docker run --rm -v "$(PWD)":/mnt koalaman/shellcheck:stable -s sh droplet/zed-open.sh

verify: build typecheck lint test ## Everything a PR should pass
	@echo "✅ verify passed"

##@ 🎨 Lint & format

lint: ## ray lint: package.json, icons, ESLint, Prettier
	npm run lint

fix-lint: ## ray lint --fix
	npm run fix-lint

format-check: ## Prettier check on src/ without writing
	npx prettier --check src

##@ 🚀 Run

dev: ## Load the extension into Raycast with hot reload
	npm run dev

##@ 🔒 Security

audit: ## Dependency CVEs (npm audit, high and above)
	npm audit --audit-level=high

scan-fs: require-docker ## Trivy: dependency CVEs + hardcoded secrets + misconfig
	$(TRIVY) -v "$(PWD)":/src aquasec/trivy:latest fs \
		--scanners vuln,secret,misconfig \
		--severity $(SEVERITY) --exit-code 1 \
		--skip-dirs /src/node_modules --skip-dirs /src/dist \
		/src

scan-secrets: require-docker ## Gitleaks: leaked credentials in git history + working tree
	docker run --rm -v "$(PWD)":/repo $(GITLEAKS_GIT) \
		zricethezav/gitleaks:latest git /repo --redact --verbose
	docker run --rm -v "$(PWD)":/repo \
		zricethezav/gitleaks:latest dir /repo --redact --verbose

security: audit scan-fs scan-secrets ## Fast gate: all source checks
	@echo "✅ security passed"

##@ 🧹 Clean

clean: ## Remove build output
	rm -rf dist

clean-all: clean ## Also remove node_modules (asks for confirmation first)
	@echo "About to delete:"
	@echo "  node_modules/"
	@printf "Proceed? [y/N] "; read ans; [ "$$ans" = "y" ] || { echo "aborted"; exit 1; }
	rm -rf node_modules

require-docker:
	@docker info >/dev/null 2>&1 || { \
		echo "❌ Docker is not running — start Docker Desktop."; \
		echo "   Needed for: scan-fs, scan-secrets, shellcheck"; \
		exit 1; }

# Every target, no exceptions — a directory sharing a target name (dist/)
# would otherwise make make treat that target as already up to date.
.PHONY: help install build build-dist icon droplet test typecheck shellcheck verify lint fix-lint format-check dev \
	audit scan-fs scan-secrets security clean clean-all require-docker
